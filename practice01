            for(int i = 0; i < len; i++){
                if(a[i].name == name){
                    cout << "Tim thay mon an:" << endl;
                    cout << a[i].name << endl;
                    cout << a[i].id << endl;
                    cout << a[i].price << endl;
                    cout << a[i].quantity << endl;
                    return;
                }
            }

    cout << "Khong tim thay mon an" << endl;
}

        int updatePrice(){
            int ID;
            cout << "Nhap ID mon an can cap nhat: ";
            cin >> ID;

            for (int i = 0; i < len; i++)
            {
                if (a[i].id == ID)
                {
                    cout << "Nhap gia moi: ";
                    cin >> a[i].price;

                    return 1;
                }
            }

            cout << "khong tim thay mon an" << endl;
            return 0;
        }
};

int main(){
    inforFood b;
    b.inforFirst();
    b.inputFood();
